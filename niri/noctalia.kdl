layout {

    focus-ring {
        active-color   "#56aff6"
        inactive-color "#03223a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#56aff6"
        inactive-color "#03223a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#56aff6"
        inactive-color "#075593"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#56aff680"
    }
}

recent-windows {
    highlight {
        active-color "#56aff6"
        urgent-color "#fd4663"
    }
}
