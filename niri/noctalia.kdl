layout {

    focus-ring {
        active-color   "#e49c67"
        inactive-color "#291d14"
        urgent-color   "#a96f44"
    }

    border {
        active-color   "#e49c67"
        inactive-color "#291d14"
        urgent-color   "#a96f44"
    }


    tab-indicator {
        active-color   "#e49c67"
        inactive-color "#854414"
        urgent-color   "#a96f44"
    }

    insert-hint {
        color "#e49c6780"
    }
}

recent-windows {
    highlight {
        active-color "#e49c67"
        urgent-color "#a96f44"
    }
}
