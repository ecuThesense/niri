layout {

    focus-ring {
        active-color   "#e49667"
        inactive-color "#291c14"
        urgent-color   "#895231"
    }

    border {
        active-color   "#e49667"
        inactive-color "#291c14"
        urgent-color   "#895231"
    }


    tab-indicator {
        active-color   "#e49667"
        inactive-color "#853e14"
        urgent-color   "#895231"
    }

    insert-hint {
        color "#e4966780"
    }
}

recent-windows {
    highlight {
        active-color "#e49667"
        urgent-color "#895231"
    }
}
