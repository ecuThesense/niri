layout {

    focus-ring {
        active-color   "#e49067"
        inactive-color "#291b14"
        urgent-color   "#da662e"
    }

    border {
        active-color   "#e49067"
        inactive-color "#291b14"
        urgent-color   "#da662e"
    }


    tab-indicator {
        active-color   "#e49067"
        inactive-color "#853914"
        urgent-color   "#da662e"
    }

    insert-hint {
        color "#e4906780"
    }
}

recent-windows {
    highlight {
        active-color "#e49067"
        urgent-color "#da662e"
    }
}
