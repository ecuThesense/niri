layout {

    focus-ring {
        active-color   "#67dbe4"
        inactive-color "#13252a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#67dbe4"
        inactive-color "#13252a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#67dbe4"
        inactive-color "#147d85"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#67dbe480"
    }
}

recent-windows {
    highlight {
        active-color "#67dbe4"
        urgent-color "#fd4663"
    }
}
