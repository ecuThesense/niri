layout {

    focus-ring {
        active-color   "#66b5e6"
        inactive-color "#092435"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#66b5e6"
        inactive-color "#092435"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#66b5e6"
        inactive-color "#125a87"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#66b5e680"
    }
}

recent-windows {
    highlight {
        active-color "#66b5e6"
        urgent-color "#fd4663"
    }
}
