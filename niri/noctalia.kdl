layout {

    focus-ring {
        active-color   "#6780e4"
        inactive-color "#0d1430"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#6780e4"
        inactive-color "#0d1430"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#6780e4"
        inactive-color "#142a85"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#6780e480"
    }
}

recent-windows {
    highlight {
        active-color "#6780e4"
        urgent-color "#fd4663"
    }
}
