layout {

    focus-ring {
        active-color   "#6777e4"
        inactive-color "#0e122f"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#6777e4"
        inactive-color "#0e122f"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#6777e4"
        inactive-color "#142285"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#6777e480"
    }
}

recent-windows {
    highlight {
        active-color "#6777e4"
        urgent-color "#fd4663"
    }
}
