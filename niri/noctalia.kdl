layout {

    focus-ring {
        active-color   "#7967e4"
        inactive-color "#181528"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#7967e4"
        inactive-color "#181528"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#7967e4"
        inactive-color "#241485"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#7967e480"
    }
}

recent-windows {
    highlight {
        active-color "#7967e4"
        urgent-color "#fd4663"
    }
}
