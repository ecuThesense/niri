layout {

    focus-ring {
        active-color   "#ba7dfc"
        inactive-color "#1e033a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#ba7dfc"
        inactive-color "#1e033a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#ba7dfc"
        inactive-color "#5f04c3"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#ba7dfc80"
    }
}

recent-windows {
    highlight {
        active-color "#ba7dfc"
        urgent-color "#fd4663"
    }
}
