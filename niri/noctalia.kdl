layout {

    focus-ring {
        active-color   "#f28c5a"
        inactive-color "#291b14"
        urgent-color   "#d35111"
    }

    border {
        active-color   "#f28c5a"
        inactive-color "#291b14"
        urgent-color   "#d35111"
    }


    tab-indicator {
        active-color   "#f28c5a"
        inactive-color "#90360a"
        urgent-color   "#d35111"
    }

    insert-hint {
        color "#f28c5a80"
    }
}

recent-windows {
    highlight {
        active-color "#f28c5a"
        urgent-color "#d35111"
    }
}
